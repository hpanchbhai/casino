# ───────────────────────────────────────────────────────────────────────────────
# Stock Tracker Makefile (macOS)
# - Postgres host port: 5433
# - FastAPI on :8000, Vite on :5173
# - Assumes Docker Desktop is installed for the DB container
# ───────────────────────────────────────────────────────────────────────────────

# ---- Config -------------------------------------------------------------------
SHELL := /bin/zsh

PY            ?= python3
VENV          ?= .venv
ACTIVATE      := source $(VENV)/bin/activate
API_HOST      ?= 127.0.0.1
API_PORT      ?= 8000
WEB_PORT      ?= 5173

# DB config (host port = 5433)
DB_HOST       ?= 127.0.0.1
DB_PORT       ?= 5433
DB_NAME       ?= stock_tracker
DB_USER       ?= tracker
DB_PASS       ?= trackerpass
DB_URL        := postgresql+asyncpg://$(DB_USER):$(DB_PASS)@$(DB_HOST):$(DB_PORT)/$(DB_NAME)
DB_URL_PSQL   := postgresql://$(DB_USER):$(DB_PASS)@$(DB_HOST):$(DB_PORT)/$(DB_NAME)

# Docker
PG_VOL        ?= stock-tracker_postgres_data
PG_CONT       ?= stock-postgres
PG_IMAGE      ?= postgres:16

# ETL defaults
SYMS          ?= AAPL,NVDA,MSFT,GOOGL,TSLA
PERIOD        ?= 1y
LOOKBACK      ?= 30
LIMIT         ?= 20

# Colored echoes
BLUE  := \033[1;34m
GREEN := \033[1;32m
YELL  := \033[1;33m
RED   := \033[1;31m
END   := \033[0m

# ---- Help ---------------------------------------------------------------------
.PHONY: help
help:
	@echo ""
	@echo "$(BLUE)Stock Tracker Makefile$(END)"
	@echo ""
	@echo "$(GREEN)Setup$(END)"
	@echo "  make venv              - Create venv & install backend deps"
	@echo "  make web-install       - Install frontend deps (dashboard)"
	@echo ""
	@echo "$(GREEN)Database$(END)"
	@echo "  make db-up             - Start Postgres (Docker) on host port 5433"
	@echo "  make db-bootstrap      - Create/repair schema (db/bootstrap.sql)"
	@echo "  make db-psql           - Open psql shell"
	@echo "  make db-down           - Stop & remove DB container (keeps volume)"
	@echo "  make db-reset          - DANGER: drop volume & recreate container"
	@echo ""
	@echo "$(GREEN)Run apps$(END)"
	@echo "  make api               - Start FastAPI on http://$(API_HOST):$(API_PORT)"
	@echo "  make web               - Start Vite dev server on http://127.0.0.1:$(WEB_PORT)"
	@echo ""
	@echo "$(GREEN)ETL$(END)"
	@echo "  make etl-ensure        - Ensure / ingest symbols ($(SYMS)) period=$(PERIOD)"
	@echo "  make etl-prices        - Fetch daily prices for symbols ($(SYMS)) period=$(PERIOD)"
	@echo ""
	@echo "$(GREEN)Utilities$(END)"
	@echo "  make kill-ports        - Free ports :$(API_PORT) and :$(WEB_PORT)"
	@echo "  make lint              - Ruff/Black check (if installed)"
	@echo "  make fmt               - Black format (if installed)"
	@echo ""

# ---- Setup --------------------------------------------------------------------
.PHONY: venv
venv:
	@echo "$(YELL)Creating venv & installing backend deps...$(END)"
	$(PY) -m venv $(VENV)
	$(ACTIVATE) && pip install --upgrade pip
	# Use requirements.txt if present; else install a minimal set
	@if [ -f requirements.txt ]; then \
		$(ACTIVATE) && pip install -r requirements.txt ; \
	else \
		$(ACTIVATE) && pip install fastapi uvicorn[standard] sqlalchemy[asyncio] asyncpg pydantic yfinance pandas python-dotenv requests ; \
	fi
	@echo "$(GREEN)✓ Backend ready$(END)"

.PHONY: web-install
web-install:
	@echo "$(YELL)Installing frontend deps...$(END)"
	cd dashboard && npm ci
	@echo "$(GREEN)✓ Frontend ready$(END)"

# ---- Database (Docker) --------------------------------------------------------
.PHONY: db-up
db-up:
	@echo "$(YELL)Starting Postgres container on host port $(DB_PORT)...$(END)"
	-docker volume create $(PG_VOL) >/dev/null
	-docker rm -f $(PG_CONT) >/dev/null 2>&1 || true
	docker run -d --name $(PG_CONT) \
		-e POSTGRES_USER=$(DB_USER) \
		-e POSTGRES_PASSWORD=$(DB_PASS) \
		-e POSTGRES_DB=$(DB_NAME) \
		-p $(DB_PORT):5432 \
		-v $(PG_VOL):/var/lib/postgresql/data \
		$(PG_IMAGE)
	@sleep 2
	@echo "$(GREEN)✓ Postgres up at $(DB_HOST):$(DB_PORT) → DB=$(DB_NAME)$(END)"

.PHONY: db-bootstrap
db-bootstrap:
	@echo "$(YELL)Bootstrapping schema from db/bootstrap.sql...$(END)"
	psql "$(DB_URL_PSQL)" -f db/bootstrap.sql
	@echo "$(GREEN)✓ Schema ensured$(END)"

.PHONY: db-psql
db-psql:
	psql "$(DB_URL_PSQL)"

.PHONY: db-down
db-down:
	@echo "$(YELL)Stopping DB container $(PG_CONT)...$(END)"
	-docker rm -f $(PG_CONT) >/dev/null 2>&1 || true
	@echo "$(GREEN)✓ Stopped (volume kept: $(PG_VOL))$(END)"

.PHONY: db-reset
db-reset:
	@echo "$(RED)DANGER: This will DELETE the volume $(PG_VOL) and all data!$(END)"
	@read "?Type 'yes' to proceed: " ans; \
	if [ "$$ans" = "yes" ]; then \
		docker rm -f $(PG_CONT) >/dev/null 2>&1 || true; \
		docker volume rm $(PG_VOL) || true; \
		$(MAKE) db-up; \
		$(MAKE) db-bootstrap; \
	else \
		echo "aborted."; \
	fi

# ---- Run apps -----------------------------------------------------------------
.PHONY: api
api:
	@echo "$(YELL)Starting FastAPI on http://$(API_HOST):$(API_PORT) ...$(END)"
	@echo "$(YELL)Using DATABASE_URL=$(DB_URL)$(END)"
	$(ACTIVATE) && export PYTHONPATH=. && export DATABASE_URL="$(DB_URL)" && \
	uvicorn app.main:app --reload --host $(API_HOST) --port $(API_PORT)

.PHONY: web
web:
	@echo "$(YELL)Starting Vite (dashboard) on http://127.0.0.1:$(WEB_PORT) ...$(END)"
	cd dashboard && npm run dev -- --port=$(WEB_PORT)

# ---- ETL ----------------------------------------------------------------------
.PHONY: etl-ensure
etl-ensure:
	@echo "$(YELL)Ensuring price bars for: $(SYMS) (period=$(PERIOD))$(END)"
	$(ACTIVATE) && export PYTHONPATH=. && export API_BASE="http://$(API_HOST):$(API_PORT)" && \
	$(PY) -m etl.ensure_all --period $(PERIOD) --lookback $(LOOKBACK) --limit $(LIMIT) --symbols "$(SYMS)"

.PHONY: etl-prices
etl-prices:
	@echo "$(YELL)Fetching prices for: $(SYMS) (period=$(PERIOD))$(END)"
	$(ACTIVATE) && export PYTHONPATH=. && \
	$(PY) -m etl.fetch_prices --symbols "$(SYMS)" --period $(PERIOD)

# ---- Utilities ----------------------------------------------------------------
.PHONY: kill-ports
kill-ports:
	@echo "$(YELL)Freeing :$(API_PORT) and :$(WEB_PORT) if occupied...$(END)"
	-lsof -i :$(API_PORT) | awk 'NR>1{print $$2}' | xargs -r kill -9
	-lsof -i :$(WEB_PORT) | awk 'NR>1{print $$2}' | xargs -r kill -9
	@echo "$(GREEN)✓ Ports cleared$(END)"

.PHONY: lint
lint:
	@echo "$(YELL)Running ruff & black checks (if installed)...$(END)"
	-$(ACTIVATE) && ruff check app etl
	-$(ACTIVATE) && black --check app etl

.PHONY: fmt
fmt:
	@echo "$(YELL)Formatting with black (if installed)...$(END)"
	-$(ACTIVATE) && black app etl

# ---- CRON ---------------------------------------------------------------------
.PHONY: cron-install
cron-install:
	@echo "$(YELL)Installing daily cron job for ETL ensure_all...$(END)"
	@USER_NAME=$$(whoami); \
	PROJECT_PATH=$$(pwd); \
	LOG_PATH="$$PROJECT_PATH/etl_ensure_all.log"; \
	echo "45 18 * * * cd $$PROJECT_PATH && source .venv/bin/activate && PYTHONPATH=. python -m etl.ensure_all --period 1y --lookback 30 --limit 20 --symbols \"AAPL,NVDA,MSFT,GOOGL,TSLA\" >> $$LOG_PATH 2>&1" > /tmp/stock_tracker_cron_$$USER_NAME; \
	crontab /tmp/stock_tracker_cron_$$USER_NAME; \
	rm /tmp/stock_tracker_cron_$$USER_NAME; \
	echo "$(GREEN)✓ Cron job installed!$(END)"
	@echo "View with: crontab -l"
	@echo "Logs at: etl_ensure_all.log"

